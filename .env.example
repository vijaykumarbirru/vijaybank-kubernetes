# Copy to .env (git-ignored) and fill in. Read by scripts/create-secrets.sh, which puts the
# values into Kubernetes Secrets. Never commit real values.

# Elastic Cloud managed OTLP endpoint and API key (Kibana > Add data > OpenTelemetry).
ELASTIC_OTLP_ENDPOINT=https://<your-project>.ingest.<region>.elastic.cloud:443
ELASTIC_OTLP_AUTH=ApiKey <encoded-api-key>
